# ============================================================================
#  Copiá este archivo como ".env"  (comando:  cp .env.example .env)
#  Docker Compose lee estos valores automáticamente.
# ============================================================================

# Clave con la que se firman los JWT. OBLIGATORIA y de al menos 32 caracteres.
# Generala con:  openssl rand -hex 32
# Si dejás el valor de ejemplo, el sistema no arranca en producción.
JWT_SECRET=cambiame-por-una-clave-aleatoria-de-32-o-mas-caracteres

# ¿Los contenedores se reinician solos cuando prendés la PC?
#   no              -> NO (recomendado: nada queda corriendo sin que vos quieras)
#   unless-stopped  -> sí, si no los apagaste antes
RESTART_POLICY=no

# ¿Con qué Ollama habla el agente?
OLLAMA_MODO=docker
# Con ./portal.sh motor host + ./portal.sh iniciar no se inicia Ollama en Docker.
# URL para ese modo (independiente de OLLAMA_URL):
OLLAMA_HOST_URL=http://host.docker.internal:11434
#   A) Ollama EN CONTENEDOR (por defecto): no toques nada.
OLLAMA_URL=http://ollama:11434
#
#   B) Ollama DEL HOST (usa tus modelos ya instalados + tu GPU, sin bajar nada):
#      - Poné en el servicio del sistema:  OLLAMA_HOST=0.0.0.0
#      - Descomentá la línea de abajo y reiniciá el stack.
# OLLAMA_URL=http://host.docker.internal:11434

# Cuánto tiempo el modelo queda en memoria tras responder.
#   Controla el consumo de RAM: más alto = respuestas más rápidas pero más memoria.
#   0 = se descarga apenas termina. Ejemplos: 0, 10s, 30s, 5m
OLLAMA_KEEP_ALIVE=30s

# ---------------------- Rendimiento / cuantización -------------------------
# Contexto y tamaño de tanda. Menos valores = menos VRAM.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_BATCH=128
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_PREDICT_CLASIFICAR=160
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32

# Caché KV cuantizada (q8_0) + flash attention: reduce la VRAM del contexto.
# Si tu versión de Ollama no las soporta, quitá estas dos líneas del compose.
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# Traducción y refresco de fuentes (concurrencia).
TRAD_CONCURRENCIA=4
FEEDS_CONCURRENCIA=3
